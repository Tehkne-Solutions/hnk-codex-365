{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HNK Review Record",
  "type": "object",
  "required": ["day", "version", "state", "reviewers", "history"],
  "properties": {
    "day": {"type": "integer", "minimum": 1, "maximum": 365},
    "version": {"type": "string"},
    "state": {"enum": ["draft", "reviewed", "canon"]},
    "reviewers": {
      "type": "object",
      "properties": {
        "editorial": {"type": "string"},
        "canonical": {"type": "string"}
      }
    },
    "epistemic_ack": {"type": "boolean"},
    "comments": {"type": "object"},
    "history": {"type": "array"}
  }
}
